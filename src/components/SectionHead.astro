---
interface Props { eyebrow: string; title: string; lead?: string; h?: 'h1' | 'h2' }
const { eyebrow, title, lead, h = 'h2' } = Astro.props;
const H = h;
---
<div class="flex flex-col gap-6 lg:flex-row lg:items-end lg:justify-between lg:gap-16">
  <div class="flex max-w-[820px] flex-col gap-4">
    <span class="eyebrow">{eyebrow}</span>
    <H class={h === 'h1' ? 'h1' : 'h2'}>{title}</H>
  </div>
  {(lead || Astro.slots.has('default')) && (
    <div class="flex flex-col gap-5 lg:w-[420px] lg:shrink-0">
      {lead && <p class="lead">{lead}</p>}
      <slot />
    </div>
  )}
</div>
