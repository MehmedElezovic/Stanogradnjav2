---
import Base from '../layouts/Base.astro';
import Img from '../components/Img.astro';
import SectionHead from '../components/SectionHead.astro';
import Specs from '../components/Specs.astro';
import AvailableFlats from '../components/AvailableFlats.astro';
import FlatsTable from '../components/FlatsTable.astro';
import CtaBand from '../components/CtaBand.astro';
import { project } from '../data/site';

const facts = [
  { k: 'Stambene jedinice', v: String(project.units) },
  { k: 'Poslovni prostori', v: String(project.commercial) },
  { k: 'Parking', v: 'Garaža + vanjski' },
  { k: 'Planirani završetak', v: project.completion },
];
---
<Base title="Aktuelni projekat Bella Vita" description="Bella Vita, stambeno-poslovni kompleks na Bulevaru na Stupu. 80 stanova, 4 poslovna prostora, završetak krajem 2027. Pogledajte dostupne stanove i tlocrte.">
  <section class="container-x pt-10 pb-12 lg:pt-14 lg:pb-16">
    <SectionHead h="h1" eyebrow="Aktuelni projekat · Sarajevsko naselje Stup" title="Bella Vita, stambeno-poslovni kompleks na Bulevaru." lead="Naš novi stambeno-poslovni kompleks sa dvije lamele, na veoma popularnoj lokaciji u sklopu novoizgrađenog naselja Bulevar na Stupu.">
      <div class="flex flex-col gap-3 sm:flex-row">
        <a href="#stanovi" class="btn-primary">Dostupni stanovi</a>
        <a href="#cjenovnik" class="btn-outline">Svi stanovi</a>
      </div>
    </SectionHead>
  </section>

  <div class="container-x">
    <Img src="/slike/bella-vita/render.jpg" alt="Vizualizacija projekta Bella Vita, pogled sa ulice" label="RENDER · Bella Vita, pogled sa ulice" class="h-80 w-full rounded-3xl md:h-[520px] lg:h-[640px]" eager />
    <dl class="mt-6 grid grid-cols-2 gap-3 lg:grid-cols-4 lg:gap-4">
      {facts.map((f) => (
        <div class="flex flex-col-reverse gap-1 rounded-[14px] border border-line px-5 py-5 lg:px-6"><dd class="text-2xl font-extrabold tracking-[-0.02em] md:text-[28px]">{f.v}</dd><dt class="text-[13px] text-muted">{f.k}</dt></div>
      ))}
    </dl>
  </div>

  <section class="container-x mt-24 flex flex-col gap-10 lg:mt-32">
    <SectionHead eyebrow="Galerija" title="Pogled na projekat." lead="Fotografije sa gradilišta i vizualizacije objekta. Ažuriramo ih kako gradnja napreduje." />
    <div class="grid grid-cols-2 gap-3 md:grid-cols-12 md:grid-rows-[300px_300px] md:gap-4">
      <Img src="/slike/bella-vita/galerija-2.jpg" alt="Bella Vita, fotografija 2" label="FOTO 2" class="col-span-2 h-72 rounded-2xl md:col-span-5 md:row-span-2 md:h-full" />
      <Img src="/slike/bella-vita/galerija-3.jpg" alt="Bella Vita, fotografija 3" label="FOTO 3" class="col-span-2 h-56 rounded-2xl md:col-span-7 md:h-full" />
      <Img src="/slike/bella-vita/galerija-4.jpg" alt="Bella Vita, fotografija 4" label="FOTO 4" class="h-40 rounded-2xl md:col-span-4 md:h-full" />
      <Img src="/slike/bella-vita/enterijer.jpg" alt="Bella Vita, enterijer" label="ENTERIJER" class="h-40 rounded-2xl md:col-span-3 md:h-full" />
    </div>
  </section>

  <Specs />
  <AvailableFlats />
  <FlatsTable />

  <section class="container-x mt-24 flex flex-col gap-10 lg:mt-32 lg:flex-row lg:items-stretch lg:gap-16">
    <div class="flex flex-col justify-center gap-5 lg:w-[420px] lg:shrink-0">
      <span class="eyebrow">Lokacija</span>
      <h2 class="h2 lg:text-[52px]">Bulevar na Stupu.</h2>
      <p class="text-[17px] leading-[1.65] text-muted">Kompleks se nalazi na veoma popularnoj lokaciji, u sklopu novoizgrađenog naselja Bulevar na Stupu, u ulici Stupska.</p>
      <dl class="mt-2 flex flex-col">
        <div class="flex justify-between border-t border-line py-3.5"><dt class="text-muted">Adresa</dt><dd class="font-bold">Stupska, 71210 Ilidža</dd></div>
        <div class="flex justify-between border-t border-line py-3.5"><dt class="text-muted">Centar grada</dt><dd class="font-bold">[x min]</dd></div>
        <div class="flex justify-between border-y border-line py-3.5"><dt class="text-muted">Škola, vrtić, trgovine</dt><dd class="font-bold">[x min]</dd></div>
      </dl>
    </div>
    <iframe src="https://www.google.com/maps?q=Stupska,+71210+Ilid%C5%BEa&output=embed" title="Mapa: Bulevar na Stupu" class="h-80 w-full flex-1 rounded-[20px] border-0 lg:h-[560px]" loading="lazy" referrerpolicy="no-referrer-when-downgrade"></iframe>
  </section>

  <CtaBand />
</Base>
