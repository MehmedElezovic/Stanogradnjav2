---
import Base from '../layouts/Base.astro';
import Img from '../components/Img.astro';
import Stats from '../components/Stats.astro';
import Specs from '../components/Specs.astro';
import AvailableFlats from '../components/AvailableFlats.astro';
import ProjectCard from '../components/ProjectCard.astro';
import ContactSection from '../components/ContactSection.astro';
import { site, project } from '../data/site';
import { dostupni } from '../lib/stanovi';
import projekti from '../data/projekti.json';

const investor = projekti.filter((p) => p.uloga === 'investitor');
const izvodjac = projekti.filter((p) => p.uloga === 'izvodjac');
const featured = izvodjac.filter((p) => p.istaknut).slice(0, 4);
const rest = izvodjac.filter((p) => !featured.includes(p));
const facts = [
  { k: 'Lokacija', v: 'Stupska ulica, Ilidža' },
  { k: 'Objekat', v: '2 lamele · 8 spratova' },
  { k: 'Strukture', v: 'Dvosobni do peterosobni' },
  { k: 'Planirani završetak', v: 'Kraj 2027. godine' },
];
const steps = [
  { t: 'Lokacija', d: 'Zemljište u traženim naseljima' },
  { t: 'Planiranje', d: 'Projekat po mjeri porodica' },
  { t: 'Izgradnja', d: 'Provjereni izvođači, naš nadzor' },
  { t: 'Useljenje', d: 'Ključevi useljivog stana' },
];
---
<Base title="Početna">
  <!-- Hero -->
  <section class="container-x flex flex-col gap-10 pt-10 pb-16 lg:flex-row lg:items-stretch lg:gap-16 lg:pt-[72px] lg:pb-20">
    <div class="flex flex-col justify-center gap-7 lg:w-[600px] lg:shrink-0">
      <div class="flex items-center gap-2.5 text-sm font-semibold text-brand-dark"><span class="h-[3px] w-7 rounded bg-brand"></span>Investitor stambenih objekata od 2008.</div>
      <h1 class="text-5xl leading-[1.02] font-extrabold tracking-[-0.035em] md:text-6xl lg:text-[76px]">Pronađite vaš <span class="text-brand">dom iz snova.</span></h1>
      <p class="max-w-[520px] text-lg leading-[1.6] text-muted md:text-[19px]">Planiramo, finansiramo i vodimo izgradnju stambeno-poslovnih objekata u Sarajevu. Sa provjerenim izvođačima gradimo domove u kojima se lijepo živi.</p>
      <div class="flex flex-col gap-3 sm:flex-row">
        <a href="#stanovi" class="btn-primary h-[54px] px-7">Pogledajte dostupne stanove</a>
        <a href="/zavrseni-projekti" class="btn-outline h-[54px] px-7">Naši projekti</a>
      </div>
    </div>
    <div class="relative min-h-[380px] flex-1 overflow-hidden rounded-[20px] md:min-h-[520px] lg:min-h-[620px]">
      <Img src="/slike/bella-vita/hero.jpg" alt="Vizualizacija projekta Bella Vita na Stupu" label="FOTO / RENDER · Bella Vita, Stup" class="absolute inset-0 h-full w-full" eager labelTop />
      <div class="absolute right-4 bottom-4 left-4 flex flex-wrap items-center gap-x-7 gap-y-3 rounded-[14px] bg-white p-5 shadow-[0_12px_32px_rgba(14,27,38,.10)] sm:right-auto sm:left-7 sm:bottom-7">
        <div class="flex flex-col gap-0.5"><span class="text-xs font-semibold text-brand-dark">NOVI PROJEKAT</span><span class="text-lg font-bold">{project.name} · Stup</span></div>
        <div class="hidden h-10 w-px bg-line sm:block"></div>
        <div class="flex flex-col gap-0.5"><span class="text-xs text-muted">Slobodno</span><span class="text-lg font-extrabold">{dostupni.length} stanova</span></div>
        <a href="/aktuelni-projekat" class="btn h-11 bg-tint px-4 text-sm text-brand-darker hover:bg-[#d3ecf8]">Prikaži projekat</a>
      </div>
    </div>
  </section>

  <Stats items={[
    { value: '2008.', label: 'osnovani u Sarajevu' },
    { value: '60+', label: 'izgrađenih stanova kao investitor' },
    { value: '6', label: 'poslovnih prostora' },
    { value: String(project.units), label: 'novih stanova u izgradnji' },
  ]} />

  <!-- Aktuelni projekat -->
  <section id="projekat" class="container-x mt-24 flex flex-col gap-12 lg:mt-32">
    <div class="flex flex-col gap-6 lg:flex-row lg:items-end lg:justify-between">
      <div class="flex max-w-[760px] flex-col gap-4">
        <span class="eyebrow">Aktuelni projekat · Sarajevsko naselje Stup</span>
        <h2 class="h2 lg:text-[60px]">Bella Vita, stambeno-poslovni kompleks na Bulevaru.</h2>
      </div>
      <p class="lead lg:w-[420px] lg:shrink-0">Dvije lamele na veoma popularnoj lokaciji, u sklopu novoizgrađenog naselja Bulevar na Stupu. 80 stambenih jedinica, 4 poslovna prostora, garaža i vanjski parking.</p>
    </div>
    <div class="grid grid-cols-2 gap-3 md:grid-cols-12 md:grid-rows-[280px_280px] md:gap-4">
      <Img src="/slike/bella-vita/galerija-1.jpg" alt="Bella Vita, fotografija 1" label="FOTO 1" class="col-span-2 h-72 rounded-2xl md:col-span-7 md:row-span-2 md:h-full" />
      <Img src="/slike/bella-vita/galerija-2.jpg" alt="Bella Vita, fotografija 2" label="FOTO 2" class="col-span-2 h-48 rounded-2xl md:col-span-5 md:h-full" />
      <Img src="/slike/bella-vita/galerija-3.jpg" alt="Bella Vita, fotografija 3" label="FOTO 3" class="h-40 rounded-2xl md:col-span-3 md:h-full" />
      <Img src="/slike/bella-vita/galerija-4.jpg" alt="Bella Vita, fotografija 4" label="FOTO 4" class="h-40 rounded-2xl md:col-span-2 md:h-full" />
    </div>
    <dl class="grid grid-cols-2 gap-3 lg:grid-cols-4 lg:gap-4">
      {facts.map((f) => (
        <div class="flex flex-col-reverse gap-1 rounded-[14px] border border-line px-5 py-5 lg:px-6"><dd class="text-[17px] font-bold">{f.v}</dd><dt class="text-[13px] text-muted">{f.k}</dt></div>
      ))}
    </dl>
  </section>

  <Specs />
  <AvailableFlats />

  <!-- Završeni projekti -->
  <section id="zavrseni" class="container-x mt-24 flex flex-col gap-12 lg:mt-32">
    <div class="flex flex-col gap-6 sm:flex-row sm:items-end sm:justify-between">
      <div class="flex flex-col gap-4">
        <span class="eyebrow">Završeni projekti</span>
        <h2 class="h2 lg:text-[60px]">Domovi koje smo već predali.</h2>
      </div>
      <a href="/zavrseni-projekti" class="btn-outline h-12 w-fit text-[15px]">Svi projekti →</a>
    </div>
    <div class="grid gap-10 md:grid-cols-2 md:gap-6">
      {investor.map((p) => <ProjectCard p={p} size="lg" />)}
    </div>
    <div class="grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-4">
      {featured.map((p) => (
        <article class="flex flex-col overflow-hidden rounded-2xl border border-line">
          <Img src={`/slike/projekti/${p.slug}.jpg`} alt={p.naziv} label="" class="h-40 w-full" />
          <div class="flex flex-col gap-1 px-5 py-4"><span class="text-xs font-bold text-brand-dark uppercase">Izvođač · {p.kategorija}</span><span class="text-base font-bold">{p.naziv}</span></div>
        </article>
      ))}
    </div>
    <div class="flex flex-wrap items-center gap-3 text-sm">
      <span class="mr-1 font-semibold text-muted">Također:</span>
      {rest.map((p) => <span class="rounded-full bg-soft px-3.5 py-2 font-medium">{p.naziv}</span>)}
    </div>
  </section>

  <!-- O nama -->
  <section id="onama" class="container-x mt-24 flex flex-col gap-10 lg:mt-32 lg:flex-row lg:items-stretch lg:gap-16">
    <Img src="/slike/o-nama.jpg" alt="Stanogradnja na gradilištu" label="FOTO · gradilište ili tim na terenu" class="h-80 w-full rounded-[20px] lg:h-auto lg:min-h-[560px] lg:w-[560px] lg:shrink-0" />
    <div class="flex flex-1 flex-col justify-center gap-7">
      <span class="eyebrow">O nama</span>
      <h2 class="text-4xl leading-[1.06] font-extrabold tracking-[-0.03em] md:text-[52px]">Mi smo investitor. Od prve skice do predaje ključeva.</h2>
      <p class="text-[17px] leading-[1.65] text-muted">Stanogradnja d.o.o. Sarajevo je društvo za građevinarstvo, inžinjering, trgovinu i usluge, osnovano 2008. godine. Vodimo cijeli projekat: lokaciju, planiranje, finansiranje i kontrolu kvaliteta, a izvođenje povjeravamo provjerenim podizvođačima.</p>
      <ol class="grid gap-3.5 sm:grid-cols-2">
        {steps.map((s, i) => (
          <li class="flex items-start gap-3.5 rounded-[14px] border border-line p-[18px]">
            <span class="flex h-9 w-9 shrink-0 items-center justify-center rounded-[10px] bg-tint font-extrabold text-brand-dark">{i + 1}</span>
            <span class="flex flex-col gap-0.5"><span class="font-bold">{s.t}</span><span class="text-sm text-muted">{s.d}</span></span>
          </li>
        ))}
      </ol>
      <a href="/o-nama" class="w-fit text-[15px] font-bold no-underline">Više o nama →</a>
    </div>
  </section>

  <ContactSection class="mt-24 lg:mt-32" />
  <div class="container-x mt-6">
    <iframe src={site.mapEmbed} title="Mapa: Stupska 19 b-1, Ilidža" class="h-72 w-full rounded-[20px] border-0 lg:h-[280px]" loading="lazy" referrerpolicy="no-referrer-when-downgrade"></iframe>
  </div>
</Base>
