---
import Base from '../layouts/Base.astro';
import SectionHead from '../components/SectionHead.astro';
import ContactSection from '../components/ContactSection.astro';
import { site } from '../data/site';
const rows = [
  { k: 'Sjedište', v: site.address.full },
  { k: 'Osnovano', v: '2008.' },
  { k: 'ID broj', v: site.idBroj },
  { k: 'PDV broj', v: site.pdvBroj },
  { k: 'Telefon', v: site.phones[1].label },
  { k: 'E-mail', v: site.email },
];
---
<Base title="Kontakt" description="Kontaktirajte Stanogradnju: Stupska 19 b-1, Ilidža. Tel. +387 62 386 733, info@stanogradnja.ba.">
  <section class="container-x pt-10 pb-12 lg:pt-14 lg:pb-16">
    <SectionHead h="h1" eyebrow="Kontakt" title="Hajde da razgovaramo." lead="Pitajte za dostupne stanove, zakažite obilazak ili nam se javite sa poslovnim upitom." />
  </section>
  <ContactSection />
  <div class="container-x mt-6">
    <iframe src={site.mapEmbed} title="Mapa: Stupska 19 b-1, Ilidža" class="h-80 w-full rounded-[20px] border-0 md:h-[480px]" loading="lazy" referrerpolicy="no-referrer-when-downgrade"></iframe>
  </div>
  <section class="container-x mt-24 flex flex-col gap-8 lg:mt-32 lg:flex-row lg:gap-16">
    <div class="flex flex-col gap-4 lg:w-[420px] lg:shrink-0">
      <span class="eyebrow">Podaci o firmi</span>
      <h2 class="text-3xl leading-[1.06] font-extrabold tracking-[-0.03em] md:text-[44px]">Stanogradnja d.o.o. Sarajevo</h2>
    </div>
    <dl class="grid flex-1 gap-x-12 text-base md:grid-cols-2">
      {rows.map((r) => (
        <div class="flex justify-between gap-4 border-t border-line py-[18px] last:border-b md:[&:nth-last-child(2)]:border-b"><dt class="text-muted">{r.k}</dt><dd class="text-right font-bold">{r.v}</dd></div>
      ))}
    </dl>
  </section>
</Base>
